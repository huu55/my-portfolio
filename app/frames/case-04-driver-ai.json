{"w":1700,"h":2935,"tree":{"id":"446:24194","t":"FRAME","n":"Section 04 / Design Philosophy","x":0.0,"y":0.0,"w":1700.0,"h":2935.0,"fill":[{"k":"solid","c":[16,18,14,1.0],"o":1}],"kids":[{"id":"446:24195","t":"GROUP","n":"Group 1312315713","x":1341.0,"y":143.0,"w":359.0,"h":571.0,"kids":[{"id":"446:24196","t":"RECTANGLE","n":"Rectangle 4371","x":1341.0,"y":143.0,"w":359.0,"h":571.0,"m":1,"fill":[{"k":"solid","c":[16,18,14,1.0],"o":1}]},{"id":"446:24197","t":"ELLIPSE","n":"Decorative orbit 1","x":1370.0,"y":195.0,"w":430.0,"h":430.0,"stroke":[{"c":[105,113,51,1.0],"w":1.0,"o":1}]},{"id":"446:24198","t":"ELLIPSE","n":"Decorative orbit 2","x":1460.0,"y":285.0,"w":250.0,"h":250.0,"stroke":[{"c":[77,83,41,1.0],"w":1.0,"o":1}]}]},{"id":"446:24200","t":"TEXT","n":"Philosophy headline","x":947.0,"y":175.0,"w":703.0,"h":112.0,"txt":"司机AI听单助手","fs":100.0,"fw":700,"ff":"Inter","lh":112.0,"ls":0,"al":"LEFT","c":[246,242,233,1.0]},{"id":"446:24213","t":"IMAGE","n":"Process step 01 / 发现","x":443.0,"y":361.0,"w":1207.0,"h":234.0,"fill":[{"k":"img","src":"/figma/case-assets/crop-case-04-driver-ai-446-24213.webp","fit":"FILL"}]},{"id":"446:24221","t":"TEXT","n":"问题 工具分散且有门槛 缺乏情绪价值","x":488.0,"y":739.0,"w":120.0,"h":148.0,"txt":"问题\n\n\n工具分散且有门槛\n\n缺乏情绪价值","fs":15.0,"fw":600,"ff":"PingFang SC","lh":21.0,"ls":0,"al":"LEFT","c":[246,242,233,1.0]},{"id":"446:24222","t":"TEXT","n":"交互流程 正常流程：司机输入问题 → AI 识别意图归入两大类之一 → 调用对应知识源 → 组织回答 → 展示答案 + 反馈按钮   识别不出意图时： AI 判","x":488.0,"y":1024.0,"w":1120.0,"h":211.0,"txt":"交互流程\n\n正常流程：司机输入问题 → AI 识别意图归入两大类之一 → 调用对应知识源 → 组织回答 → 展示答案 + 反馈按钮\n \n识别不出意图时：\nAI 判断该问题不属于\"奖励／听单\"两类：明确告知当前能力范围 / AI 不确定问题：追问一次澄清，最多一次，不反复追问\n \n答不准时：这是整个产品体验的下限。兜底做得好，用户信任不崩；兜底做得差，一次错误回答可能比没有 AI 助手更糟。\n优先级 1：模型对答案不确定时，宁可不答也不乱答。/ 优先级 2：涉及申诉、投诉、金钱、异常状态的，不走 AI，直接转人工。","fs":15.0,"fw":600,"ff":"PingFang SC","lh":21.0,"ls":0,"al":"LEFT","c":[246,242,233,1.0]},{"id":"446:24223","t":"TEXT","n":"详细描述 功能散落在不同入口,什么时候用哪个、怎么组合使用效果更好,需要司机积累丰富经验才能摸清。 现有工具都是\"纯工具\"属性。平峰没单是客观存在的问题,工具无","x":877.0,"y":739.0,"w":731.0,"h":211.0,"txt":"详细描述\n\n\n功能散落在不同入口,什么时候用哪个、怎么组合使用效果更好,需要司机积累丰富经验才能摸清。\n\n现有工具都是\"纯工具\"属性。平峰没单是客观存在的问题,工具无法在客观没单的情况下给司机一个情绪出口、缓解接单焦虑;即便转接客服,体验上同样有落差。\n\n两个层面叠加,形成了\"司机有困惑 → 现有工具解决不了\"的缺口,这也是 AI 助手介入的空间。","fs":15.0,"fw":600,"ff":"PingFang SC","lh":21.0,"ls":0,"al":"LEFT","c":[246,242,233,1.0]},{"id":"446:24224","t":"IMAGE","n":"Group 1312315709","x":488.0,"y":2111.0,"w":1030.44,"h":229.48,"fill":[{"k":"img","src":"/figma/case-assets/crop-case-04-driver-ai-446-24224.webp","fit":"FILL"}]},{"id":"446:25599","t":"IMAGE","n":"Group 1312315710","x":488.0,"y":2450.0,"w":1098.53,"h":279.05,"fill":[{"k":"img","src":"/figma/case-assets/crop-case-04-driver-ai-446-25599.webp","fit":"FILL"}]},{"id":"446:26356","t":"IMAGE","n":"Image Placeholder / 智能汽车座椅 visual","x":488.0,"y":1367.0,"w":1098.0,"h":605.0,"fill":[{"k":"img","src":"/figma/case-assets/crop-case-04-driver-ai-446-26356.webp","fit":"FILL"}]}]}}